---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "startseite");
if (!page) throw new Error("Startseiten-Inhalt fehlt");
const { Content } = await render(page);
const courses = (await getCollection("courses"))
  .filter((course) => course.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const course = courses[0];
---

<BaseLayout title={page.data.title} description={page.data.description} pageClass="home">
  <section class="manifesto">
    <p>{page.data.quote}</p>
  </section>

  <section class="about section-shell" id="ueber-heidi">
    <div class="about-heading">
      <p class="eyebrow">Über Heidi</p>
      <h2>
        <span class="about-title-line">Ich glaube an die Kraft,</span>{" "}
        <span class="about-title-line">die längst in dir wohnt.</span>
      </h2>
    </div>
    <div class="about-copy">
      <Content />
    </div>
    <div class="heidi-gallery" aria-label="Sechs persönliche Bilder von Heidi">
      <figure class="heidi-gallery__item">
        <img
          src="/assets/heidi/heidi-portrait.jpg"
          alt="Heidi lächelt mit einer Seesternkette in die Kamera"
          loading="lazy"
          decoding="async"
          width="900"
          height="900"
        />
        <figcaption>Das bin ich</figcaption>
      </figure>
      <figure class="heidi-gallery__item">
        <img
          src="/assets/heidi/heidi-kappe.jpg"
          alt="Heidi mit Kappe und einem verschmitzten Blick"
          loading="lazy"
          decoding="async"
          width="900"
          height="900"
        />
        <figcaption>Das auch</figcaption>
      </figure>
      <figure class="heidi-gallery__item">
        <img
          src="/assets/heidi/heidi-tape-spielerisch.jpg"
          alt="Heidi mit rosafarbenen Tapes im Gesicht und einem spielerischen Blick"
          loading="lazy"
          decoding="async"
          width="900"
          height="900"
        />
        <figcaption>Das auch 😉</figcaption>
      </figure>
      <figure class="heidi-gallery__item">
        <img
          src="/assets/heidi/heidi-muetze-sonne.jpg"
          alt="Heidi mit Mütze in der Sonne und einer Flasche in der Hand"
          loading="lazy"
          decoding="async"
          width="900"
          height="900"
        />
      </figure>
      <figure class="heidi-gallery__item">
        <img
          src="/assets/heidi/heidi-unterwegs.jpg"
          alt="Heidi unterwegs mit einem rosafarbenen Tape auf der Stirn"
          loading="lazy"
          decoding="async"
          width="900"
          height="900"
        />
      </figure>
      <figure class="heidi-gallery__item">
        <img
          src="/assets/heidi/heidi-stadtplatz.jpg"
          alt="Heidi vor grünen Figuren auf einem Stadtplatz"
          loading="lazy"
          decoding="async"
          width="900"
          height="900"
        />
      </figure>
    </div>
    <a class="instagram-card" href="https://www.instagram.com/loesungsfinderin/" target="_blank" rel="noopener noreferrer">
      <span class="instagram-mark" aria-hidden="true">◎</span>
      <span><small>Mehr von Heidi auf Instagram</small><strong>@loesungsfinderin</strong></span>
      <span aria-hidden="true">↗</span>
    </a>
  </section>

  {course && (
    <section class="course-section section-shell" id="kurse">
      <div class="course-heading">
        <p class="eyebrow">Aktueller Kurs</p>
        <h2>Kurse</h2>
      </div>
      <article class="course-card">
        <div class="course-card-media">
          <img src={course.data.flyer} alt={course.data.flyerAlt} loading="lazy" />
        </div>
        <div class="course-card-body">
          <p>{course.data.subtitle}</p>
          <h3>{course.data.title}</h3>
          <a class="button button--light" href={`/kurse/${course.id}/`}>Infos zum Kurs</a>
        </div>
      </article>
    </section>
  )}

  <section class="recommendations section-shell" id="empfehlungen">
    <div>
      <p class="eyebrow">Mit Bedacht gewählt</p>
      <h2>Was Heidi in ihren Kursen verwendet.</h2>
    </div>
    <div class="recommendations-note">
      <span aria-hidden="true">✦</span>
      <p>Hier entsteht eine kleine, ehrliche Sammlung von Dingen, die Heidi selbst nutzt und gern weiterempfiehlt – transparent als Affiliate-Links gekennzeichnet.</p>
      <small>Die ersten Empfehlungen folgen mit den Kursinhalten.</small>
    </div>
  </section>
</BaseLayout>

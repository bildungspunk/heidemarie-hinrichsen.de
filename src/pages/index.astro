---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "startseite");
if (!page) throw new Error("Startseiten-Inhalt fehlt");
const courses = (await getCollection("courses"))
  .filter((course) => course.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const course = courses[0];
---

<BaseLayout title={page.data.title} description={page.data.description} pageClass="home">
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow">{page.data.kicker}</p>
      <h1>Zurück in deine Kraft.<br /><em>Zurück zu dir.</em></h1>
      <p class="hero-intro">{page.data.intro}</p>
      <div class="button-row">
        <a class="button button--primary" href="#kurse">Kurse entdecken</a>
        <a class="text-link" href="#ueber-heidi">Heidi kennenlernen <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-sun"></div>
      <div class="hero-line hero-line--one"></div>
      <div class="hero-line hero-line--two"></div>
      <span class="hero-flower hero-flower--one">✿</span>
      <span class="hero-flower hero-flower--two">✿</span>
      <span class="hero-leaf hero-leaf--one"></span>
      <span class="hero-leaf hero-leaf--two"></span>
      <p>Du darfst dir selbst<br />wieder wichtig werden.</p>
    </div>
  </section>

  <section class="manifesto">
    <p>{page.data.quote}</p>
  </section>

  <section class="about section-shell" id="ueber-heidi">
    <div class="section-number" aria-hidden="true">01</div>
    <div class="about-heading">
      <p class="eyebrow">Über Heidi</p>
      <h2>{page.data.aboutTitle}</h2>
    </div>
    <div class="about-copy">
      <p class="lead">{page.data.aboutLead}</p>
      {page.data.aboutText.map((paragraph) => <p>{paragraph}</p>)}
      <a class="instagram-card" href="https://www.instagram.com/loesungsfinderin/" target="_blank" rel="noopener noreferrer">
        <span class="instagram-mark" aria-hidden="true">◎</span>
        <span><small>Mehr von Heidi auf Instagram</small><strong>@loesungsfinderin</strong></span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  {course && (
    <section class="course-section section-shell" id="kurse">
      <div class="course-heading">
        <p class="eyebrow">Aktueller Kurs</p>
        <h2>Zeit, die nur dir gehört.</h2>
        <p>Jeder Kurs bekommt seine eigene Seite – mit allen Informationen und einem direkten Weg zur Buchung beim jeweiligen Anbieter.</p>
      </div>
      <article class="course-card">
        <div class="course-card-top">
          <span>{course.data.badge}</span>
          <span>{course.data.eyebrow}</span>
        </div>
        <div class="course-card-body">
          <p>{course.data.subtitle}</p>
          <h3>{course.data.title}</h3>
          <p class="course-description">{course.data.description}</p>
          <dl>
            <div><dt>Wann</dt><dd>{course.data.dates}</dd></div>
            <div><dt>Wo</dt><dd>{course.data.location}</dd></div>
          </dl>
          <a class="button button--light" href={`/kurse/${course.id}/`}>Zum Kurs</a>
        </div>
      </article>
    </section>
  )}

  <section class="recommendations section-shell" id="empfehlungen">
    <div>
      <p class="eyebrow">Mit Bedacht gewählt</p>
      <h2>Was Heidi in ihren Kursen verwendet.</h2>
    </div>
    <div class="recommendations-note">
      <span aria-hidden="true">✦</span>
      <p>Hier entsteht eine kleine, ehrliche Sammlung von Dingen, die Heidi selbst nutzt und gern weiterempfiehlt – transparent als Affiliate-Links gekennzeichnet.</p>
      <small>Die ersten Empfehlungen folgen mit den Kursinhalten.</small>
    </div>
  </section>
</BaseLayout>

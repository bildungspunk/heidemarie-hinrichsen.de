---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("legal", "datenschutz");
if (!entry) throw new Error("Datenschutz-Inhalt fehlt");
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Heidi Hinrichsen`} description={entry.data.description} canonicalPath="/datenschutz/" pageClass="legal-page">
  <article class="legal-content section-shell">
    <p class="eyebrow">{entry.data.status}</p>
    <h1>{entry.data.title}</h1>
    <div class="legal-prose"><Content /></div>
  </article>
</BaseLayout>

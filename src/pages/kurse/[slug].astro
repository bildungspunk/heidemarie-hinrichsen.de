---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
}

interface Props {
  course: CollectionEntry<"courses">;
}

const { course } = Astro.props;
const { Content } = await render(course);
---

<BaseLayout
  title={`${course.data.title} | Heidi Hinrichsen`}
  description={course.data.description}
  canonicalPath={`/kurse/${course.id}/`}
  pageClass="course-detail course-detail--flyer"
  socialImage={null}
>
  <section class="flyer-course section-shell">
    <a class="back-link back-link--dark" href="/kurse/">← Alle Kurse</a>
    <div class="flyer-course-grid">
      <a class="flyer-link" href={course.data.bookingUrl} target="_blank" rel="noopener noreferrer" aria-label={`Infos und Kurs bei der ${course.data.provider} buchen`}>
        <img src={course.data.flyer} alt={course.data.flyerAlt} />
      </a>
      <article class="flyer-course-copy">
        <h1>{course.data.title}</h1>
        <p class="course-tags">{course.data.subtitle}</p>
        <div class="course-approved-copy"><Content /></div>
        <a class="button button--primary" href={course.data.bookingUrl} target="_blank" rel="noopener noreferrer">Infos und Kurs buchen hier ↗</a>
      </article>
    </div>
  </section>
</BaseLayout>

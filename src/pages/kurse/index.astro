---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const courses = (await getCollection("courses")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Kurse | Heidi Hinrichsen"
  description="Kurse von Heidi Hinrichsen für Selbstfürsorge, Körperwahrnehmung und neue Kraft."
  canonicalPath="/kurse/"
  pageClass="courses-page"
>
  <section class="page-hero section-shell">
    <h1>Kurse</h1>
  </section>

  <section class="course-list section-shell" aria-label="Alle Kurse">
    {courses.map((course) => (
      <article class="course-list-card">
        <img class="course-list-flyer" src={course.data.flyer} alt={course.data.flyerAlt} loading="lazy" />
        <div>
          <p class="eyebrow">Infos zum Kurs</p>
          <h2>{course.data.title}</h2>
          <p class="course-list-subtitle">{course.data.subtitle}</p>
        </div>
        <a class="button button--primary" href={`/kurse/${course.id}/`}>Infos zum Kurs</a>
      </article>
    ))}
  </section>

</BaseLayout>
